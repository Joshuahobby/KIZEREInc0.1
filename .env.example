# ===========================
# KIZERE Inc. Environment Variables
# ===========================
# Copy this file to .env and fill in the values

# Server
NODE_ENV=production
PORT=5000
SESSION_SECRET=your-session-secret-here
RESEND_API_KEY=re_your-resend-api-key
RESEND_WEBHOOK_SECRET=whsec_your-webhook-secret

# Database (PostgreSQL)
DATABASE_URL=postgres://kizere:password@localhost:5432/kizere
DB_PASSWORD=your-db-password

# PawaPay Payments (Mobile Money)
PAWAPAY_API_TOKEN=your-pawapay-api-token
MOCK_PAYMENTS=false

# Firebase (Authentication)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Frontend URL (for CORS & WebSocket)
FRONTEND_URL=https://kizere.rw

# Google Analytics 4 (GA4)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Docker Compose DB password
DB_PASSWORD=your-secure-password
