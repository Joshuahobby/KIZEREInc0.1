# ===========================
# KIZERE Inc. Environment Variables
# ===========================
# Copy this file to .env and fill in the values

# Server
NODE_ENV=production
PORT=5000
SESSION_SECRET=your-session-secret-here

# Database (PostgreSQL)
DATABASE_URL=postgres://kizere:password@localhost:5432/kizere
DB_PASSWORD=your-db-password

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your-stripe-key
VITE_STRIPE_PUBLIC_KEY=pk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Firebase (Authentication)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Frontend URL (for CORS & WebSocket)
FRONTEND_URL=https://kizere.rw

# Docker Compose DB password
DB_PASSWORD=your-secure-password
