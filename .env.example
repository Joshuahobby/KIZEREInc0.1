# ===========================
# KIZERE Inc. Environment Variables
# ===========================
# Copy this file to .env and fill in the values

# Server
NODE_ENV=production
PORT=5000
SESSION_SECRET=your-session-secret-here
RESEND_API_KEY=re_your-resend-api-key
RESEND_WEBHOOK_SECRET=whsec_your-webhook-secret

# Database (PostgreSQL)
DATABASE_URL=postgres://kizere:password@localhost:5432/kizere
DB_PASSWORD=your-db-password

# PawaPay Payments (Mobile Money)
# Get these from the PawaPay merchant portal → Settings → API Keys
PAWAPAY_API_TOKEN=your-pawapay-api-token
# Set to 'production' to hit the live PawaPay API (default: sandbox)
PAWAPAY_MODE=production
# Required for signing outgoing requests (PawaPay Settings → HTTP Signing → Key ID)
PAWAPAY_SIGNING_KEY_ID=your-signing-key-id
# ECDSA P-256 private key in PEM format; replace newlines with \n
PAWAPAY_SIGNING_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
# Set to 'true' in development to skip real PawaPay API calls (returns mock ACCEPTED)
MOCK_PAYMENTS=false

# Firebase (Authentication)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Frontend URL (for CORS & WebSocket)
FRONTEND_URL=https://kizere.rw
# Canonical public URL — used in QR codes, email links, and cron notifications
APP_URL=https://kizere.rw

# Google Analytics 4 (GA4)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Docker Compose DB password
DB_PASSWORD=your-secure-password
